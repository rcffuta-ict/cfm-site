# ─────────────────────────────────────────────────────────────────────────────
# CFM — environment
#
# Copy to `.env.development` for local work, or set these in the Vercel project
# settings for the cloud deployments. Never commit a filled-in copy: the service
# role key below both reads the whole database and signs session cookies.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and keys, from Supabase → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS, so every game table trusts it — and it is also the
# HMAC secret for the session cookie, so changing it signs everyone out.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser-side equivalents. Only the anon key is ever exposed here; the TV
# screens use it for the Supabase Realtime channel that carries game updates.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Which event this deployment is bound to ──────────────────────────────────
# Matches `events.slug`. Drives registration, the Oracle, and the /about page.
# Flipping that row's `is_active` turns the whole app on or off without a
# redeploy.
CFM_EVENT_SLUG=cfm-rcffuta

# ── Who counts as admin ──────────────────────────────────────────────────────
# The leadership position slug whose holder, in the active tenure, gets the
# Oracle console and the game host panel.
ADMIN=ict-coord

# ── On-screen assistance during games ────────────────────────────────────────
# Set to 1 to help players: bingo cards tint squares whose item has been called,
# and phones list what's already been announced.
#
# Off by default, deliberately. Those helpers make bingo noticeably easier and
# pull attention away from the caller and the big screen. Useful for a rehearsal
# or a gentler room; not how the game is meant to be played.
#
# GAME_HELPERS=1

# Starting number for generated Oracle IDs.
RAFFLE_ID_BASE=1000

# Absolute base URL, used where a full link is needed (emails, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── The venue laptop only ────────────────────────────────────────────────────
# Set to 1 ONLY on the machine running the Oracle on the church LAN.
#
# That machine serves a production build over plain HTTP (http://192.168.x.x),
# and browsers silently discard `secure` cookies on a non-HTTPS origin — so the
# admin logs in, the cookie is dropped, and nothing happens. This drops the
# `secure` flag for that one deployment.
#
# Leave it unset everywhere else. On the public site it would make the session
# cookie sendable over plain HTTP.
#
# ORACLE_LOCAL=1

# ── Set automatically by Vercel ──────────────────────────────────────────────
# Nothing to configure. VERCEL_ENV drives the "Preview build" banner, and
# VERCEL_GIT_COMMIT_REF / _SHA label it with the branch and commit.
